func multiply(Matrix A, B) -> Matrix {
    const m = A.rows()
    const n = A.columns()
    const o = B.rows()
    const p = B.columns()

    assert(n == o, "A.columns() must equal B.rows()")

    const AT = transpose(A)
    Matrix C(m, p, 0.0)

    for j in 0..<p {
        for i in 0..<m {
            for k in 0..<n {
                C[i,j] += AT[k,i] * B[k,j]
            }
        }
    }

    return C
}
